{
  "name": "ai-task-worker",
  "version": "0.1.0",
  "private": true,
  "description": "Prototype autonomous AI worker: takes a natural-language task and completes it using a browser, files and APIs against a simulated company environment.",
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "start": "tsx src/server/index.ts",
    "dev": "tsx watch src/server/index.ts",
    "mockco": "tsx src/mockco/main.ts",
    "task": "tsx src/cli.ts",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "postinstall": "playwright install chromium"
  },
  "dependencies": {
    "express": "^4.21.2",
    "playwright": "1.64.1",
    "undici": "^7.30.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
