# --- LLM (any OpenAI-compatible chat-completions endpoint with tool calling) ---

# Option A (default): Groq free tier, open-weight models. Free key: https://console.groq.com/keys
LLM_BASE_URL=https://api.groq.com/openai/v1
# One key, or several comma-separated keys (key1,key2). Keys are used round-robin; a rate-limited key is
# parked for the provider's retry-after and the next key is used at once. Only helps if the keys have
# SEPARATE quotas — Groq limits are per organisation, so keys from one account share a single quota.
LLM_API_KEY=
# One model, or several comma-separated in priority order. The next model is used only when every key is
# rate-limited on the previous one. Groq limits are per model, so a fallback model adds real quota.
LLM_MODEL=openai/gpt-oss-120b,llama-3.3-70b-versatile
# Other Groq models that work: openai/gpt-oss-20b, qwen/qwen3.8-27b

# Option B: fully local with Ollama (https://ollama.com) — `ollama pull qwen3:8b`
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen3:8b

# --- Agent behaviour ---
# risky  = ask before irreversible / outward-facing actions (default)
# always = ask before every state-changing action
# never  = fully autonomous (still logged)
APPROVAL_MODE=risky
MAX_STEPS=40
# Show the browser window while the agent works
HEADLESS=true

# --- Simulated company environment ---
AGENT_PORT=3000
MOCKCO_PORT=4000
# Inject realistic failures (first bill submission returns 503, slow pages) to exercise recovery
MOCKCO_CHAOS=true
